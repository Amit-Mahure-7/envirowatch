# ================================
# EnviroWatch Server Configuration
# ================================

# OpenWeatherMap API Key (get free key from openweathermap.org)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# WAQI Air Quality API Token (get free token from aqicn.org/data-platform/token)
WAQI_API_TOKEN=your_waqi_api_token_here

# MongoDB Connection URI (optional - for caching)
MONGODB_URI=mongodb://localhost:27017/envirowatch

# Server Port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
